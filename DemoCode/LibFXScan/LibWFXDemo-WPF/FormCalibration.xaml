<Window x:Class="LibWFXDemo_CSharp.FormCalibration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibWFXDemo_CSharp"
        mc:Ignorable="d" Height="112.374" Width="300" ShowInTaskbar="False" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid Margin="0,6,10,0">
        <Grid.Background>
            <ImageBrush/>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="153*"/>
            <ColumnDefinition Width="139*"/>
        </Grid.ColumnDefinitions>
        <Label x:Name="label" Content="Calibration in progress..." HorizontalAlignment="Left" Margin="53,17,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" FontSize="16"/>
        <Label x:Name="label2" Content="Please wait 3~40 seconds" HorizontalAlignment="Left" Margin="50,52,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" FontSize="16"/>
    </Grid>
</Window>
