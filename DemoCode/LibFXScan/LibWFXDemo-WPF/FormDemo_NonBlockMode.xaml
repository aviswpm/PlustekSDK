<Window x:Class="LibWFXDemo_CSharp.FormDemo_NonBlockMode"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibWFXDemo_WPF"
        mc:Ignorable="d"
        Title="Demo - C#" Height="471" Width="885" ResizeMode="NoResize" Foreground="Black" Loaded="FormMain_Load" Closing="FormDemo_FormClosing">
    <Grid HorizontalAlignment="Left" Width="875" RenderTransformOrigin="0.978,0.506">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460*"/>
            <ColumnDefinition Width="91*"/>
            <ColumnDefinition Width="305*"/>
            <ColumnDefinition Width="19*"/>

        </Grid.ColumnDefinitions>
        <TextBox x:Name="TXT_LOG" HorizontalAlignment="Left" Height="163" Margin="34,24,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="413" Background="#FFF7F5F5" BorderBrush="#FFA8A3A3"/>
        <Label x:Name="label" Content="Device" HorizontalAlignment="Left" Margin="31,195,0,0" VerticalAlignment="Top" Height="25" Width="48"/>
        <ComboBox x:Name="COMBO_DEVICE" HorizontalAlignment="Left" Margin="88,197,0,0" VerticalAlignment="Top" Width="259" SelectionChanged="COMBO_DEVICE_SelectionChanged" Height="21"/>
        <Button x:Name="BTN_REFRESH" Content="Refresh" HorizontalAlignment="Left" Margin="373,199,0,0" VerticalAlignment="Top" Width="74" Click="BTN_REFRESH_Click" Height="19"/>
        <Label x:Name="label1" Content="Command" HorizontalAlignment="Left" Margin="31,225,0,0" VerticalAlignment="Top" Height="25" Width="69"/>
        <Button x:Name="BTN_EDIT" Content="Edit" HorizontalAlignment="Left" Margin="107,228,0,0" VerticalAlignment="Top" Width="29" Click="BTN_EDIT_Click" Height="19"/>
        <ComboBox x:Name="COMBO_COMMAND" HorizontalAlignment="Left" Margin="155,229,0,0" VerticalAlignment="Top" Width="292" AllowDrop="True" IsEditable="True" Height="21" >
            <ComboBox.Resources>
                <Style TargetType="Popup">
                </Style>
            </ComboBox.Resources>
        </ComboBox>
        <Grid Margin="0,14,0,-14">
            <ProgressBar x:Name="PROGRESS_BAR" Value="{Binding InsertBindingHere}" HorizontalAlignment="Left" Height="16" Margin="34,245,0,0" VerticalAlignment="Top" Width="413" AutomationProperties.ItemStatus="0"/>
            <TextBlock Text="{Binding ElementName=PROGRESS_BAR, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="230,246,194,182" Width="36" />
        </Grid>
        <GroupBox x:Name="groupBox" Header="Normal" HorizontalAlignment="Left" Margin="34,283,0,0" VerticalAlignment="Top" Height="133" Width="413">
            <Button x:Name="BTN_SET" Content="Set" HorizontalAlignment="Left" Margin="8,9,0,0" VerticalAlignment="Top" Width="181" Click="BTN_SET_Click" Background="#FF7AD3FD" />
        </GroupBox>
        <Button x:Name="BTN_PAPER_READY" Content="PaperReady" HorizontalAlignment="Left" Margin="48,342,0,0" VerticalAlignment="Top" Width="86" Click="BTN_PAPER_READY_Click" Height="19" />
        <Button x:Name="BTN_ECO" Content="ECO" HorizontalAlignment="Left" Margin="345,342,0,0" VerticalAlignment="Top" Width="86" Click="BTN_ECO_Click" Height="19" />
        <Button x:Name="BTN_PAPER_STATUS" Content="PaperStatus" HorizontalAlignment="Left" Margin="144,342,0,0" VerticalAlignment="Top" Width="86" Click="BTN_PAPER_STATUS_Click" Height="19" />
        <Button x:Name="BTN_CALIBRATE" Content="Calibrate" HorizontalAlignment="Left" Margin="249,342,0,0" VerticalAlignment="Top" Width="86" Click="BTN_CALIBRATE_Click" Height="19" />
        <Button x:Name="BTN_MERGETOPDF" Content="MergePDF" HorizontalAlignment="Left" Margin="48,375,0,0" VerticalAlignment="Top" Width="78" Click="BTN_MERGETOPDF_Click" Height="19" />
        <Button x:Name="BTN_RECYCLESAVEFOLDER" Content="RecycleSaveFolder" HorizontalAlignment="Left" Margin="136,375,0,0" VerticalAlignment="Top" Width="120" Height="19" Click="BTN_RECYCLESAVEFOLDER_Click" />
        <Image x:Name="PIC_1" Margin="1,25,18,254" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center" Width="396"  Height="163" Grid.ColumnSpan="3" Grid.Column="1"/>
        <GroupBox x:Name="groupBox_Copy" Header="VTM" HorizontalAlignment="Left" Margin="3,367,0,0" VerticalAlignment="Top" Height="72" Width="209" Grid.Column="1" Grid.ColumnSpan="2" HorizontalContentAlignment="Center">
            <ComboBox x:Name="COMBO_EJECT_DIRECTION" HorizontalAlignment="Center" Margin="4,3,5,0" VerticalAlignment="Top" Width="183" SelectedIndex="0">
                <ComboBoxItem Content="eject backwarding- force"/>
                <ComboBoxItem Content="eject forwarding- force"/>
                <ComboBoxItem Content="eject backwarding stop- force"/>
                <ComboBoxItem Content="eject forwarding stop- force"/>
                <ComboBoxItem Content="eject backwarding"/>
                <ComboBoxItem Content="eject forwarding"/>
                <ComboBoxItem Content="eject backwarding stop"/>
                <ComboBoxItem Content="eject forwarding stop"/>
                <ComboBoxItem Content="eject backwarding by steps"/>
                <ComboBoxItem Content="eject forwarding by steps"/>
            </ComboBox>
        </GroupBox>
        <Button x:Name="BTN_EJECT_PAPER" Content="EjectPaper" HorizontalAlignment="Left" Margin="48,414,0,0" VerticalAlignment="Top" Width="86" Grid.Column="1" Click="BTN_EJECT_PAPER_Click" Height="19" Grid.ColumnSpan="2" />
        <Button x:Name="BTN_EXIT" Content="X" Grid.Column="2" HorizontalAlignment="Left" Margin="303,-74,0,497" VerticalAlignment="Bottom" Width="18" Background="#FFDE2525" BorderBrush="#FF9B9292" Foreground="#FFF3EDED" Height="19" Grid.ColumnSpan="2" />

        <Image x:Name="PIC_2" Margin="1,198,18,81" RenderTransformOrigin="0.846,0.507" HorizontalAlignment="Center" VerticalAlignment="Center" Width="396" Height="163" Grid.ColumnSpan="3" Grid.Column="1" />
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="164" Margin="0,24,0,0" VerticalAlignment="Top" Width="401" Grid.ColumnSpan="3" Grid.Column="1"/>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="164" Margin="0,198,0,0" VerticalAlignment="Top" Width="401" Grid.ColumnSpan="3" Grid.Column="1"/>
        <Button x:Name="BTN_SCAN" Content="Scan" HorizontalAlignment="Left" Margin="249,308,0,0" VerticalAlignment="Top" Width="180" Height="19" Background="#FF7AD3FD" Click="BTN_SCAN_Click"/>
        <Button x:Name="BTN_REGISTER"   Margin="301,-2,-2,0" VerticalAlignment="Top" Grid.Column="2" Height="25" Click="BTN_REGISTER_Click" Grid.ColumnSpan="2" Background="White" BorderBrush="White" >
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Image/license.ico" Width="20" Height="20" RenderTransformOrigin="-13.483,-8.517" OpacityMask="White"/>
                </StackPanel>
            </Button.Content>
        </Button>
    </Grid>
</Window>
